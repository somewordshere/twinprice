{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Twinprice",
  "homepage_url": "https://twinprice.com/",
  "version": "2.2.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.frankfurter.dev/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/browser-api.js",
        "shared/currencies.js",
        "shared/settings.js",
        "shared/i18n.js",
        "shared/translations-page.js",
        "shared/messages.js",
        "content/number-parser.js",
        "content/detector.js",
        "content/conversion-registry.js",
        "content/mutation-root-scheduler.js",
        "content/converter.js",
        "content/page-ui.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Twinprice",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "onboarding/onboarding.html",
    "open_in_tab": true
  },
  "commands": {
    "convert-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Convert prices on the current page"
    }
  }
}
