.DS_Store
Thumbs.db
node_modules/
coverage/
artifacts/
playwright-report/
test-results/
dist/
web-ext-artifacts/
local/
.wrangler/
.claude/settings.local.json
*.log

# Store: commit listing text and final upload images; keep raw inputs local
store/source/
store/video/*.mp4
store/growth.md

# Keep generated unpacked builds out of the repository
release/unpacked/
release/*.zip
release/*/*/
!release/*-chrome-store.zip

# Publish the screenshots folder: the README images (v2-*) and the numbered shots
screenshots/*
!screenshots/*.png
!screenshots/v2-popup-light.png
!screenshots/v2-popup-dark.png
!screenshots/v2-popup-options.png
!screenshots/v2-inpage-prompt.png
!screenshots/v2-inpage.png
!screenshots/v2-inpage-selection.png
!screenshots/v2-inpage-selection-done.png

# Preserve historical screenshots restored from Git history
!screenshots/old/
!screenshots/old/**
